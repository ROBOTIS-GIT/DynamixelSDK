;;
;; Serial / USB is a host capability. Kotoba guest code cannot open a UART
;; (no-interop). A host that owns the port should:
;;
;;   1. ask the guest for instruction bytes (ping-byte, write1-byte, ...)
;;   2. write those bytes on the wire
;;   3. read status bytes
;;   4. pass those bytes into the guest decode helpers
;;
;; Fixture tests never open a device. They compose encode + a canned rx
;; buffer (tests/goldens.txt).

(defn port-is-host-capability [] 1)

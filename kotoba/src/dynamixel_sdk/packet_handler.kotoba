;;
;; Python PacketHandler(protocol_version) selects Protocol 1.0 or 2.0.
;; Kotoba v1 only admits Protocol 2.0 (see protocol2.kotoba). Protocol 1.0 is
;; a documented follow-up so this file stays a version tag, not a second codec.

(defn default-protocol-version [] 2)
